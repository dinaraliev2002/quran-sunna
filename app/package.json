{
  "name": "quran-sunna-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "data": "node scripts/fetch-data.mjs",
    "deploy:test": "npm run build && node scripts/deploy.mjs test",
    "release": "npm run build && node scripts/deploy.mjs release",
    "sync": "npm run build && cap sync",
    "icons": "capacitor-assets generate --iconBackgroundColor \"#0E4A31\" --iconBackgroundColorDark \"#0E4A31\" --splashBackgroundColor \"#0E1110\" --splashBackgroundColorDark \"#0E1110\"",
    "store-data": "python -I scripts/build-asbab.py --store --out store-data/asbab && python -I scripts/build-kuliev.py --draft --out store-data/kuliev",
    "sync:store": "npm run build && node scripts/apply-store-data.mjs && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
