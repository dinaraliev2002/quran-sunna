{"v":"6f26808f","books":{"wadii":{"author":"Мукбиль ибн Хади аль-Вадии","short":"аль-Вадии","title":"ас-Сахих аль-муснад мин асбаб ан-нузуль","about":"Достоверное с цепочками передатчиков о причинах ниспослания аятов. Автор приводит только то, что считает достоверным или хорошим, и разбирает цепочки.","edition":"Каир, «Мактабат Ибн Таймия», 4-е изд., 1987"},"muharrar":{"author":"Халид ибн Сулейман аль-Музайни","short":"аль-Музайни","title":"аль-Мухаррар фи асбаб нузуль аль-Куран","about":"Исследование причин ниспослания по девяти главным сборникам хадисов: автор проверяет и достоверность предания, и то, действительно ли это причина ниспослания.","edition":"Даммам, «Дар Ибн аль-Джаузи», 1-е изд., 2006"},"wahidi":{"author":"Абу аль-Хасан ‘Али ибн Ахмад аль-Вахиди","short":"аль-Вахиди","title":"Асбаб нузуль аль-Куран","about":"Одна из первых книг о причинах ниспослания (V век хиджры). Автор собирает всё, что передано, не отделяя достоверное от слабого, поэтому к каждому преданию приведена оценка исследователя Исама аль-Хумайдана. Цепочки самого аль-Вахиди до известных передатчиков сокращены.","edition":"Даммам, «Дар аль-Ислах», 2-е изд., 1992, исследование ‘Исама ибн ‘Абд аль-Мухсина аль-Хумайдана"},"istiab":{"author":"Салим ибн ‘Ид аль-Хиляли и Мухаммад ибн Муса Аль Наср","short":"аль-Хиляли и Аль Наср","title":"аль-Исти‘аб фи байан аль-асбаб","about":"Свод преданий о причинах ниспослания из книг тафсира и хадиса — достоверных и слабых. Авторы, ученики аль-Альбани, проверяют цепочку каждого предания и ставят ему оценку.","edition":"Даммам, «Дар Ибн аль-Джаузи», 1-е изд., 1425 г. х., в трёх томах"}},"s":{"2":[[1,2],[6,6],[14,14],[19,19],[26,26],[41,41],[44,44],[62,62],[75,75],[76,76],[79,79],[80,80],[85,85],[89,89],[96,96],[97,97],[98,98],[99,99],[100,100],[102,102],[104,104],[105,105],[106,106],[108,108],[109,109],[113,113],[114,114],[115,115],[116,116],[118,118],[119,119],[120,120],[121,121],[125,125],[130,130],[133,133],[135,135],[136,136],[138,138],[141,141],[142,1